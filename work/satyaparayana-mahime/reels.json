      "title_lead": "His Answer:", "title_main": "\u201cYou Are My Refuge\u201d",
      "subs": [
        ["\u201cBrother, of our property,", 0.1, 3.5],
        ["half is yours, half is mine.", 3.6, 6.4],
        ["I'll give you my whole share \u2014", 6.5, 9.3],
        ["count that as the debt paid.", 9.4, 11.4],
        ["I am a disciple of the Math.", 11.5, 13.2],
        ["I'll pay it for my guru.", 13.2, 16.2],
        ["Take my half and go.\u201d", 16.3, 18.7],
        ["Ramanna Nayaka said, \u201cFine \u2014", 18.8, 20.9],
        ["my money back is enough.\u201d", 20.9, 23.7],
        ["His guru asked Tammanna:", 23.8, 26.3],
        ["\u201cIf you give away everything,", 26.4, 28.2],
        ["what will become of you?\u201d", 28.3, 29.6],
        ["\u201cYou are my refuge,\u201d he said.", 29.6, 31.5]
