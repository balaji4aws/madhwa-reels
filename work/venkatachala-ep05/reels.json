        "hashtags_kn": "#\u0c95\u0ca8\u0ccd\u0ca8\u0ca1 #\u0caa\u0ccd\u0cb0\u0cb5\u0c9a\u0ca8 #\u0cb5\u0cc7\u0c82\u0c95\u0c9f\u0cbe\u0c9a\u0cb2 #\u0cb6\u0ccd\u0cb0\u0cc0\u0ca8\u0cbf\u0cb5\u0cbe\u0cb8 #\u0cae\u0ca7\u0ccd\u0cb5"
